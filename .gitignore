# ── KiCad ─────────────────────────────────────────────────────────────────────
# Keep source files, ignore auto-generated outputs
*.000
*.bak
*.bck
*-backups/
_autosave-*
# Per-user local settings
*.kicad_prl
fp-info-cache
# Lock files while a file is open in KiCad
*.lck
# KiCad local history (backups kept on this machine)
.history/

# KiCad export outputs (regenerate from source)
gerbers/
hardware/pcb/**/*.gbr
hardware/pcb/**/*.drl
hardware/pcb/**/*.dxf
hardware/pcb/**/*.svg
hardware/pcb/**/*.pdf
hardware/pcb/**/*.pos
hardware/pcb/**/*.rpt
hardware/pcb/**/*.net
hardware/pcb/**/*.xml
hardware/pcb/**/*.zip
.history/

# ── EasyEDA / other PCB tools ─────────────────────────────────────────────────
*.epro

# ── FreeCAD / OpenSCAD (enclosure) ────────────────────────────────────────────
*.FCBak


# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── MkDocs ────────────────────────────────────────────────────────────────────
site/

